DATABASE_URL=postgresql://user:pass@host:5432/fundry

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set to a real random value in Render's dashboard for production —
# never commit an actual secret here.
SECRET_KEY=change-me-to-a-long-random-value

# From your Google Cloud Console OAuth client (Web application type).
# Only the client ID is needed here — token verification never touches the
# client secret, since the frontend uses Google Identity Services' implicit
# ID-token flow rather than the server-side authorization-code exchange.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase Storage, for founder profile picture / gallery / demo video
# uploads (app/routers/media.py). Project Settings -> API in your Supabase
# dashboard. The service role key is server-side only — never expose it to
# the frontend. Also create a public bucket matching SUPABASE_STORAGE_BUCKET
# (default "founder-media") in Supabase Storage before using uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=founder-media

# Paystack (payments/billing) — https://paystack.com/docs
# Test vs live is just the key prefix (sk_test_... / sk_live_...) against
# the same https://api.paystack.co — there's no separate sandbox base URL
# the way Bachs had. Webhooks are verified with this SAME secret key —
# Paystack has no separate webhook-signing secret (see
# app/services/webhook_verify.py). The public key is used by the
# frontend if it ever needs Paystack's inline JS widget; this backend
# only needs the secret key.
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Plan codes (PLN_...) for each paid (tier, interval) combination, per
# role. starter is free — no plan needed. Create all 8 recurring plans in
# the Paystack dashboard (basic ₦2,000/mo & ₦24,000/yr, premium
# ₦5,000/mo & ₦60,000/yr — ₦50,000/yr as the discounted promo price —
# for both founders and investors), then paste their PLN_... codes here.
PAYSTACK_FOUNDER_BASIC_MONTHLY_PLAN_CODE=PLN_replace_me
PAYSTACK_FOUNDER_BASIC_ANNUAL_PLAN_CODE=PLN_replace_me
PAYSTACK_FOUNDER_PREMIUM_MONTHLY_PLAN_CODE=PLN_replace_me
PAYSTACK_FOUNDER_PREMIUM_ANNUAL_PLAN_CODE=PLN_replace_me
PAYSTACK_INVESTOR_BASIC_MONTHLY_PLAN_CODE=PLN_replace_me
PAYSTACK_INVESTOR_BASIC_ANNUAL_PLAN_CODE=PLN_replace_me
PAYSTACK_INVESTOR_PREMIUM_MONTHLY_PLAN_CODE=PLN_replace_me
PAYSTACK_INVESTOR_PREMIUM_ANNUAL_PLAN_CODE=PLN_replace_me

# Where Paystack sends the browser back to after payment (success or
# cancelled — Paystack doesn't use separate URLs for each the way Bachs
# did). Fulfilment depends only on the webhook, never on this redirect —
# see app/routers/billing.py.
FRONTEND_BILLING_RETURN_URL=http://localhost:3000/billing?billing=success
FRONTEND_BILLING_CANCEL_URL=http://localhost:3000/billing?billing=cancelled
