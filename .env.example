DATABASE_URL=postgresql://user:pass@host:5432/fundry

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set to a real random value in Render's dashboard for production —
# never commit an actual secret here.
SECRET_KEY=change-me-to-a-long-random-value

# From your Google Cloud Console OAuth client (Web application type).
# Only the client ID is needed here — token verification never touches the
# client secret, since the frontend uses Google Identity Services' implicit
# ID-token flow rather than the server-side authorization-code exchange.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase Storage, for founder profile picture / gallery / demo video
# uploads (app/routers/media.py). Project Settings -> API in your Supabase
# dashboard. The service role key is server-side only — never expose it to
# the frontend. Also create a public bucket matching SUPABASE_STORAGE_BUCKET
# (default "founder-media") in Supabase Storage before using uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=founder-media

# Bachs (payments/billing) — https://docs.bachs.io
# Sandbox first: sk_sandbox_... against the sandbox URL below. Going live
# is a key swap: sk_live_... + https://api.bachs.io.
BACHS_API_KEY=sk_sandbox_your_key_here
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
# From the Bachs dashboard's webhook settings — used to verify inbound
# webhook signatures in app/services/webhook_verify.py.
BACHS_WEBHOOK_SECRET=your-webhook-signing-secret

# Product ids for the recurring "Founder Premium" (gold verification)
# plan — create both a monthly and an annual recurring product in the
# Bachs dashboard first, then paste their prod_... ids here.
# Product ids for each paid (tier, interval) combination, per role.
# starter is free — no product needed. Create all 8 recurring products in
# the Bachs dashboard (basic ₦3,000/mo & ₦30,000/yr, premium ₦5,000/mo &
# ₦50,000/yr, for both founders and investors), then paste their
# prod_... ids here.
BACHS_FOUNDER_BASIC_MONTHLY_PRODUCT_ID=prod_replace_me
BACHS_FOUNDER_BASIC_ANNUAL_PRODUCT_ID=prod_replace_me
BACHS_FOUNDER_PREMIUM_MONTHLY_PRODUCT_ID=prod_replace_me
BACHS_FOUNDER_PREMIUM_ANNUAL_PRODUCT_ID=prod_replace_me
BACHS_INVESTOR_BASIC_MONTHLY_PRODUCT_ID=prod_replace_me
BACHS_INVESTOR_BASIC_ANNUAL_PRODUCT_ID=prod_replace_me
BACHS_INVESTOR_PREMIUM_MONTHLY_PRODUCT_ID=prod_replace_me
BACHS_INVESTOR_PREMIUM_ANNUAL_PRODUCT_ID=prod_replace_me

# Where Bachs' hosted checkout sends the browser back to. Fulfilment
# depends only on the webhook, never on this redirect — see
# app/routers/billing.py.
FRONTEND_BILLING_RETURN_URL=http://localhost:3000/billing?billing=success
FRONTEND_BILLING_CANCEL_URL=http://localhost:3000/billing?billing=cancelled
